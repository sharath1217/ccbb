{
  "name": "ccbb",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" && node tests/e2e.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node tests/e2e.mjs",
    "start": "python3 -m http.server 8000",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "description": "Free virtual electronics lab: build, simulate and test circuits before buying parts.",
  "license": "GPL-3.0-or-later",
  "author": "ccbb contributors",
  "main": "desktop/main.cjs",
  "homepage": "https://github.com/sharath1217/ccbb",
  "build": {
    "appId": "org.ccbb.lab",
    "productName": "ccbb",
    "copyright": "GPL-3.0 \u00b7 free for everyone",
    "files": [
      "index.html",
      "app/**",
      "vendor/**",
      "desktop/**",
      "screenshots/app-5-dimmer.png",
      "LICENSE",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ccbb Circuit Lab",
      "license": "LICENSE"
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop/icon.png",
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}